---
import { NAVIGATION, SITE } from '../../data';

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-10 -mx-4 mb-10 border-b border-retro_dark/10 bg-[#b9b99df2] px-4 backdrop-blur md:-mx-6 md:px-6">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 py-4 md:flex-row md:items-center md:justify-between">
    <a href="/" class="text-lg font-semibold tracking-tight text-retro_dark hover:text-retro_red">
      {SITE.author}
    </a>

    <nav aria-label="Primary navigation">
      <ul class="flex flex-wrap items-center gap-2 text-sm md:text-base">
        {NAVIGATION.map((item) => {
          const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'rounded-full px-3 py-1.5 transition hover:bg-retro_light/50 hover:text-retro_dark',
                  isActive && 'bg-retro_blue text-white hover:bg-retro_blue hover:text-white',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
