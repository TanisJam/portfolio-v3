---
import { NAVIGATION } from '../../data';

interface Props {
  current: string;
}

const { current } = Astro.props;

const NAV_ICONS: Record<string, string> = {
  '/': 'crow',
  '/blog': 'blog',
  '/projects': 'map',
  '/resume': 'id',
};
---

<nav class="nav-chips" aria-label="Primary">
  {
    NAVIGATION.map((n) => {
      const icon = NAV_ICONS[n.href];
      const isCurrent = current === n.href;
      return (
        <a href={n.href} class="nav-chip" aria-current={isCurrent ? 'page' : undefined}>
          {icon === 'crow' && (
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M3 14c1.5-3 4-5 7.5-5.5 2-2 4.5-2 6.5 0 1 0 2 .5 2.5 1.5L21 12l-2 2 .5 3-3-.5-2 2H9c-3 0-5-1-6-4Z" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="17" cy="9.5" r="0.8" fill="currentColor"/>
            </svg>
          )}
          {icon === 'blog' && (
            <svg viewBox="0 0 24 24">
              <path d="M5 4h12a2 2 0 0 1 2 2v14l-3-2-3 2-3-2-3 2-3-2V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" fill="none"/>
              <path d="M8 9h8M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.8"/>
            </svg>
          )}
          {icon === 'map' && (
            <svg viewBox="0 0 24 24" fill="none">
              <path d="m3 6 6-2 6 2 6-2v14l-6 2-6-2-6 2V6Z" stroke="currentColor" stroke-width="1.8"/>
              <path d="M9 4v14M15 6v14" stroke="currentColor" stroke-width="1.8"/>
            </svg>
          )}
          {icon === 'id' && (
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="9" cy="11" r="2" stroke="currentColor" stroke-width="1.8"/>
              <path d="M6 16c.5-1.5 2-2.5 3-2.5s2.5 1 3 2.5M14 10h4M14 13h4M14 16h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          )}
          <span>{n.label}</span>
        </a>
      );
    })
  }
</nav>
