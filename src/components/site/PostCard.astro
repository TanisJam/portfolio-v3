---
import { formatDate } from '@utils/blog';

const {
  href,
  title,
  description,
  publishedAt,
  tags = [],
  minutes,
  featured = false,
} = Astro.props;
---

<article
  class:list={[
    'rounded-3xl border border-retro_dark/10 bg-white/25 p-6 transition hover:-translate-y-0.5 hover:bg-white/40',
    featured && 'bg-white/35 p-8 shadow-sm',
  ]}
>
  <div class="flex flex-wrap items-center gap-2 text-sm text-retro_dark/60">
    <span>{formatDate(publishedAt)}</span>
    {minutes && <><span>•</span><span>{minutes} min read</span></>}
  </div>
  <h2 class:list={['mt-2 font-semibold text-retro_dark', featured ? 'text-3xl md:text-4xl' : 'text-2xl']}>
    <a href={href} class="hover:text-retro_red">{title}</a>
  </h2>
  <p class:list={['mt-3 leading-relaxed text-retro_dark/75', featured ? 'text-lg' : 'text-base']}>
    {description}
  </p>
  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag: string) => (
          <li class="rounded-full bg-retro_light/35 px-3 py-1 text-xs font-medium uppercase tracking-wide text-retro_dark/75">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</article>
