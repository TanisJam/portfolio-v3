---
import '@styles/base.css';
import Masthead from '../components/site/Masthead.astro';
import NavChips from '../components/site/NavChips.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import DiceIsland from '../components/site/DiceIsland.astro';
import { SITE } from '../data';

interface Props {
  content?: { title?: string; description?: string };
  pageLabel?: string;
  current: string;
}

const { content = {}, pageLabel, current } = Astro.props;
const pageTitle = content.title ? `${content.title} | ${SITE.title}` : SITE.title;
const description = content.description ?? SITE.description;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body class="page noise" data-screen-label={pageLabel}>
    <div class="page-frame">
      <div class="sheet">
        <Masthead pageLabel={pageLabel} />
        <NavChips current={current} />
        <slot />
        <SiteFooter />
      </div>
      <DiceIsland />
    </div>
  </body>
</html>
