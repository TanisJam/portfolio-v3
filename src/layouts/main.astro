---
import '@styles/base.css';
import Masthead from '../components/site/Masthead.astro';
import NavChips from '../components/site/NavChips.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import DiceIsland from '../components/site/DiceIsland.astro';
import { SITE } from '../data';
import { getAlternateLanguagePath, type Lang } from '@utils/locale';

interface Props {
  content?: { title?: string; description?: string };
  current: string;
  lang: Lang;
  /** Defaults to 'website'; pass 'article' from post pages. */
  ogType?: 'website' | 'article';
  /** 404 and other error pages have no canonical URL or language alternate. */
  noindex?: boolean;
}

const { content = {}, current, lang, ogType = 'website', noindex = false } = Astro.props;
const pageTitle = content.title ? `${content.title} | ${SITE.title}` : SITE.title;
const description = content.description ?? SITE.description;

const path = Astro.url.pathname;
const canonicalUrl = new URL(path, SITE.siteUrl).toString();
const alternatePath = getAlternateLanguagePath(path, lang);
const enPath = lang === 'en' ? path : alternatePath;
const esPath = lang === 'es' ? path : alternatePath;
const enUrl = new URL(enPath, SITE.siteUrl).toString();
const esUrl = new URL(esPath, SITE.siteUrl).toString();

const OG_LOCALE: Record<Lang, string> = { en: 'en_US', es: 'es_ES' };
const ogLocale = OG_LOCALE[lang];
const ogLocaleAlternate = OG_LOCALE[lang === 'en' ? 'es' : 'en'];
const ogImageUrl = new URL(SITE.ogImage.url, SITE.siteUrl).toString();
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Las cuatro caras que se pintan arriba del fold en TODAS las paginas: el
         masthead usa Ultra ("Mauricio") y Nothing You Could Do ("Romero"), los
         chips y el eyebrow usan Kreon, y el body usa Biryani Regular. Sin esto
         el navegador recien las descubre cuando termina de parsear base.css,
         porque las @font-face viven ahi dentro. Biryani-Bold (57 KB) queda
         afuera a proposito: no siempre entra en el primer viewport.
         `crossorigin` no es opcional: las fuentes se piden en modo CORS, y un
         preload sin el atributo termina bajando el archivo dos veces. -->
    <link rel="preload" href="/fonts/Ultra-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/NothingYouCouldDo-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Kreon-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Biryani-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="es" href={esUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={SITE.ogImage.type} />
    <meta property="og:image:width" content={String(SITE.ogImage.width)} />
    <meta property="og:image:height" content={String(SITE.ogImage.height)} />
    <meta property="og:image:alt" content={SITE.ogImage.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={SITE.ogImage.alt} />
  </head>
  <body class="page noise">
    <div class="page-frame">
      <div class="sheet">
        <Masthead lang={lang} currentPath={Astro.url.pathname} />
        <NavChips current={current} lang={lang} />
        <slot />
        <SiteFooter lang={lang} />
      </div>
      <DiceIsland />
    </div>
  </body>
</html>
