---
import '@styles/base.css';
import Masthead from '../components/site/Masthead.astro';
import NavChips from '../components/site/NavChips.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import DiceIsland from '../components/site/DiceIsland.astro';
import { SITE } from '../data';
import type { Lang } from '@utils/locale';

interface Props {
  content?: { title?: string; description?: string };
  current: string;
  lang: Lang;
}

const { content = {}, current, lang } = Astro.props;
const pageTitle = content.title ? `${content.title} | ${SITE.title}` : SITE.title;
const description = content.description ?? SITE.description;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body class="page noise">
    <div class="page-frame">
      <div class="sheet">
        <Masthead lang={lang} currentPath={Astro.url.pathname} />
        <NavChips current={current} lang={lang} />
        <slot />
        <SiteFooter lang={lang} />
      </div>
      <DiceIsland />
    </div>
  </body>
</html>
