---
import Main from '@layouts/main.astro';
import { getCollection, render } from 'astro:content';
import { formatPostDate } from '@utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog-es', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Main
  current="/blog"
  lang="es"
  ogType="article"
  content={{ title: post.data.title, description: post.data.description }}
>
  <div class="article">
    <div style="margin-bottom: 10px;">
      <a class="link-underline" href="/es/blog">← Todos los posts</a>
    </div>
    <div class="label" style="margin-bottom: 6px;">{formatPostDate(post.data.publishedAt, 'es')}</div>
    <h1 class="page-title" style="font-size: clamp(38px, 10vw, 56px);">{post.data.title}</h1>
    <p class="lead" style="margin-top: 10px;">{post.data.description}</p>
    <div style="display: flex; gap: 6px; flex-wrap: wrap; margin: 4px 0 28px;">
      {post.data.tags.map((t: string) => <span class="pill pill--paper pill--sm">#{t}</span>)}
    </div>

    <Content />

    <hr class="divider" />
    <div style="display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap;">
      <a class="stamp-btn stamp-btn--ghost" href="/es/blog">← Todos los posts</a>
      <a class="stamp-btn" href="/es/">Volver al inicio</a>
    </div>
  </div>
</Main>
