---
import Main from '@layouts/main.astro';
import { TECHS } from '../../../data';
import { PROJECTS_ES } from '../../../data.es';
---

<Main
  current="/projects"
  lang="es"
  content={{
    title: 'Proyectos',
    description: 'Proyectos seleccionados de Mauricio Romero.',
  }}
>
  <div style="margin-bottom: 20px;">
    <div class="label" style="margin-bottom: 6px;">Trabajo seleccionado</div>
    <h1 class="page-title">PROYECTOS</h1>
    <div class="page-sub">apps, demos y experimentos</div>
    <p class="lead" style="margin-top: 10px;">
      Una selección de cosas que construí: trabajo de producción, side projects
      y algún experimento ocasional. Cada card incluye contexto, stack y links
      a la demo o al código fuente.
    </p>
  </div>

  <div class="row row-2" style="margin-bottom: 26px;">
    {
      PROJECTS_ES.map((p, i) => {
        const href = p.live || p.source;
        const idx = String(i + 1).padStart(2, '0');
        const status = p.live ? 'LIVE' : 'CÓDIGO';
        return (
          <article class={i === 0 ? 'proj-card proj-card--wide' : 'proj-card'}>
            <a
              class="proj-card__media"
              href={href}
              target="_blank"
              rel="noreferrer"
              aria-label={`Abrir ${p.title}`}
            >
              <img
                class="proj-card__img"
                src={p.screenshot}
                alt=""
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
              <div class="proj-card__pills">
                <span class={`pill pill--${p.accent}`}>{p.tag}</span>
              </div>
            </a>
            <div class="proj-card__reveal">
              <div>
                <div class="proj-card__spec">
                  <span class="proj-card__index">{idx}</span>
                  <span class="proj-card__code">MNR-{idx} · {status}</span>
                </div>
                <h2>{p.title}</h2>
                <p class="proj-card__subtitle">{p.subtitle}</p>
                <p>{p.description}</p>
              </div>
              <div class="techs">
                {p.techs.map((t) => <span>{t}</span>)}
              </div>
              <div class="actions">
                {p.live && (
                  <a class="primary" href={p.live} target="_blank" rel="noreferrer">Demo ↗</a>
                )}
                {p.source && (
                  <a href={p.source} target="_blank" rel="noreferrer">Código</a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <section class="ink-card" style="margin-bottom: 0;">
    <div class="ink-card__inner ink-card__inner--bordered">
      <span style="position: absolute; top: 10px; right: 10px;">
        <span class="pill pill--amber">STACK</span>
      </span>
      <div class="display-heading" style="font-size: 44px; margin: 2px 0 12px;">HECHO CON</div>
      <div class="chip-row">
        {TECHS.map((t) => <span class="chip chip--stack">{t.name}</span>)}
      </div>
    </div>
  </section>
</Main>
