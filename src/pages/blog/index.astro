---
import Main from '@layouts/main.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const tagSet = new Set<string>();
posts.forEach((p) => p.data.tags.forEach((t) => tagSet.add(t)));
const allTags = ['all', ...Array.from(tagSet)];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: '2-digit' });
---

<Main
  current="/blog"
  lang="en"
  content={{
    title: 'Blog',
    description:
      'Writing about frontend systems, internal tools, AI-assisted workflows, and personal projects.',
  }}
>
  <div style="margin-bottom: 20px;">
    <div class="label" style="margin-bottom: 6px;">Writing</div>
    <h1 class="page-title">THE BLOG</h1>
    <div class="page-sub">notes from the workbench</div>
    <p class="lead" style="margin-top: 10px;">
      Short essays on frontend systems, internal tools, AI-assisted workflows,
      and the engineering process behind good product work.
    </p>
  </div>

  <div class="tag-filter" role="group" aria-label="Filter by tag">
    {
      allTags.map((t, i) => (
        <button type="button" data-tag={t} aria-pressed={i === 0 ? 'true' : 'false'}>
          {t === 'all' ? 'All posts' : `#${t}`}
        </button>
      ))
    }
  </div>

  <div id="posts" style="display: grid; gap: 16px; margin-bottom: 10px;">
    {
      posts.map((p, i) => (
        <a
          class="post-card"
          href={`/blog/${p.slug}/`}
          data-tags={p.data.tags.join(' ')}
        >
          <div class="post-head">
            <span class="post-date">LOG-{String(i + 1).padStart(2, '0')} · {fmtDate(p.data.publishedAt)}</span>
            {p.data.featured && <span class="pill pill--amber pill--sm">Featured</span>}
          </div>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
          <div class="tags">
            {p.data.tags.map((t) => <span class="pill pill--paper pill--sm">#{t}</span>)}
          </div>
        </a>
      ))
    }
  </div>
</Main>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-filter button');
  const cards = document.querySelectorAll<HTMLAnchorElement>('#posts .post-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
      cards.forEach((card) => {
        const tags = (card.dataset.tags ?? '').split(/\s+/).filter(Boolean);
        const visible = tag === 'all' || tags.includes(tag);
        card.style.display = visible ? '' : 'none';
      });
    });
  });
</script>
